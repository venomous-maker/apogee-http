// request.grav — Request: one HTTP request as an application sees it: its
// input (query, form and JSON body merged, typed, by dotted path), route
// values, files, cookies, who is asking, and what it accepts. Every parse
// happens at most once per request, on first use.
//
//   req.input("user.name")                 // from a JSON body, a form or the query string
//   req.integer("page", 1)
//   req.boolean("remember")                // "1", "true", "on", "yes"
//   req.only(["email", "name"])
//   req.param("id")                        // a route value
//   req.file("avatar").store("uploads")    // an uploaded file
//   req.expectsJson()                      // API client, or XHR
import "std"
import "std/net"
import "apogee-container"
import "json.grav"
import "negotiation.grav"
import "response.grav"

namespace apogee {

    // A file uploaded in a multipart form.
    class UploadedFile {
        public part: FormPart
        constructor(part: FormPart) { self.part = part; }
        // The form field's name.
        fn field() -> string { return self.part.name; }
        // The file name the client gave, without any directory part.
        fn clientName() -> string {
            let n = self.part.filename;
            let slash = Str.lastIndexOf(n, "/");
            let back = Str.lastIndexOf(n, "\\");
            let cut = slash > back ? slash : back;
            return cut >= 0 ? n[cut + 1..] : n;
        }
        // The extension of the client's name, lower case, without the dot ("" for none).
        fn extension() -> string {
            let n = self.clientName();
            let dot = Str.lastIndexOf(n, ".");
            return dot > 0 ? Str.lower(n[dot + 1..]) : "";
        }
        fn mimeType() -> string { return self.part.contentType; }
        fn size() -> int { return self.part.size(); }
        fn bytes() -> Bytes { return self.part.data; }
        fn text() -> string { return self.part.text(); }
        // Saves it under `dir` as `name` (a random name with its extension when
        // ""); the path written.
        fn store(dir: string, name: string = "") -> string {
            if (!Dir.exists(dir) && !Dir.create(dir)) { throw new IOError("cannot create '${dir}'"); }
            let ext = self.extension();
            let file = name != "" ? name : Hash.randomToken(16) + (ext != "" ? "." + ext : "");
            if (Str.contains(file, "/") || Str.contains(file, "..")) { throw new ValueError("not a plain file name: " + file); }
            let path = dir + "/" + file;
            if (!new File(path).writeBinary(self.part.data.toBinary())) { throw new IOError("cannot write '${path}'"); }
            return path;
        }
    }

    // A session that keeps the last request's input for the next one (old()).
    interface OldInputStore {
        fn oldInput(key: string) -> any
        fn flashInput(values: HashMap<string, any>)
    }

    // A session's flash: values kept for the next request only (errors, messages).
    interface FlashStore {
        fn flash(key: string, value: any)
        fn flashed(key: string) -> any
    }

    // An object that validates itself once the container has made it (a form request).
    interface ValidatesWhenResolved {
        fn validateResolved()
    }

    class Request {
        // The request as it arrived.
        public http: HttpRequest
        // The application's container (set by the router; null without one). The
        // request's own scope of it is made on first use: scope().
        public app: Container
        // The matched route's name ("" when unnamed, or before routing).
        public routeName: string
        // The matched route's parameter values in order (bound models where the
        // router bound one); null before routing, or for a route without any.
        public routeValues: Array<any>
        // The authenticated user, once a guard has found one (null for a guest).
        public user: any
        // The session, once a session middleware has started one.
        public session: any
        // Honour a `_method` form field (or X-HTTP-Method-Override header) on POST.
        public static methodOverride: bool = true
        // Proxies whose X-Forwarded-* headers are believed ("10.0.0.1", "10.0.*", "*").
        public static trustedProxies: Array<string> = new Array<string>()
        // What validate() runs (installed by apogee-validation):
        // (request, data, rules, messages, attributes) -> the validated data.
        public static validator: fn(Request, HashMap<string, any>, HashMap<string, any>, HashMap<string, string>, HashMap<string, string>) -> HashMap<string, any> = null

        private attrs: HashMap<string, any>
        private inputs: HashMap<string, any>
        private bodyValue: any
        private bodyParsed: bool
        private cookieMap: HashMap<string, string>
        private files: HashMap<string, UploadedFile>
        private methodName: string
        private scoped: Container

        constructor(http: HttpRequest) {
            self.http = http;
            self.app = null;
            self.scoped = null;
            self.routeName = "";
            self.routeValues = null;
            self.user = null;
            self.session = null;
            self.attrs = null; self.inputs = null; self.bodyValue = null; self.bodyParsed = false;
            self.cookieMap = null; self.files = null; self.methodName = "";
        }
        // Takes over everything `other` holds, sharing its parsed input and
        // attributes (a form request standing for the request it was made from).
        fn adopt(other: Request) {
            self.http = other.http; self.app = other.app; self.scoped = other.scoped;
            self.routeName = other.routeName; self.routeValues = other.routeValues;
            self.user = other.user; self.session = other.session;
            other.all();                                                    // (parsed once, then shared)
            self.attrs = other.attrs; self.inputs = other.inputs; self.bodyValue = other.bodyValue;
            self.bodyParsed = other.bodyParsed; self.cookieMap = other.cookieMap; self.files = other.files;
            self.methodName = other.methodName;
            if (self.attrs == null) { other.set("apogee.shared", true); self.attrs = other.attrs; }
        }
        // A request made up in code (tests, internal sub-requests).
        static fn make(method: string, target: string, body: string = "", contentType: string = "") -> Request {
            let h = new HttpRequest(method, target, "HTTP/1.1");
            if (body != "") { h.bodyBytes = Bytes.fromString(body); }
            if (contentType != "") { h.headers.set("Content-Type", contentType); }
            h.headers.set("Host", "localhost");
            return new Request(h);
        }

        // ── the request line ───────────────────────────────────────────────────
        // The method, upper case; a POST can stand for PUT/PATCH/DELETE through a
        // `_method` field or the X-HTTP-Method-Override header.
        fn method() -> string {
            if (self.methodName != "") { return self.methodName; }
            let m = self.http.method;
            if (m == "POST" && Request.methodOverride) {
                let o = self.http.header("X-HTTP-Method-Override");
                if (o == "" && !self.http.isJson()) { o = self.text("_method"); }
                let up = Str.upper(Str.trim(o));
                if (up == "PUT" || up == "PATCH" || up == "DELETE") { m = up; }
            }
            self.methodName = m;
            return m;
        }
        fn isMethod(m: string) -> bool { return self.method() == Str.upper(m); }
        // The decoded path, always starting with "/" ("/users/7").
        fn path() -> string { return self.http.path == "" ? "/" : self.http.path; }
        // The path's segments ("/users/7" gives "users", "7").
        fn segments() -> Array<string> {
            let out = new Array<string>();
            for (p in Str.split(self.path(), "/")) { if (p != "") { out.push(p); } }
            return out;
        }
        // Segment `i` (1-based, as `segment(1)` of "/users/7" is "users"), or "".
        fn segment(i: int, fallback: string = "") -> string {
            let s = self.segments();
            return i >= 1 && i <= s.size() ? s[i - 1] : fallback;
        }
        // Whether the path matches one of `patterns` ("admin/*", "users/*/edit"; no leading slash needed).
        // (Laravel's name; pathIs() is the same.)
        fn is(patterns: Array<string>) -> bool { return self.pathIs(patterns); }
        fn pathIs(patterns: Array<string>) -> bool {
            let p = self.path()[1..];
            for (x in patterns) { if (Request.glob(Str.startsWith(x, "/") ? x[1..] : x, p)) { return true; } }
            return false;
        }
        // Whether the matched route's name matches one of `patterns` ("admin.*").
        fn routeIs(patterns: Array<string>) -> bool {
            for (x in patterns) { if (Request.glob(x, self.routeName)) { return true; } }
            return false;
        }
        // Whether the connection came from a trusted proxy (whose forwarded headers count).
        fn isFromTrustedProxy() -> bool { return TrustedProxies.trusts(Request.trustedProxies, self.http.remote); }
        // "http" or "https" (X-Forwarded-Proto from a trusted proxy).
        fn scheme() -> string {
            if (self.isFromTrustedProxy()) {
                let p = Str.lower(Str.trim(Str.split(self.http.header("X-Forwarded-Proto"), ",")[0]));
                if (p == "http" || p == "https") { return p; }
            }
            return self.http.scheme;
        }
        fn isSecure() -> bool { return self.scheme() == "https"; }
        // The Host header (or a trusted proxy's X-Forwarded-Host), port included.
        fn httpHost() -> string {
            if (self.isFromTrustedProxy()) {
                let h = Str.trim(Str.split(self.http.header("X-Forwarded-Host"), ",")[0]);
                if (h != "") { return h; }
            }
            return self.http.host();
        }
        // The host name without its port.
        fn host() -> string {
            let h = self.httpHost();
            let colon = Str.lastIndexOf(h, ":");
            return colon > 0 && Str.indexOf(h, "]") < colon ? h[..colon] : h;
        }
        // The port the client asked for (from the Host header, else the scheme's).
        fn port() -> int {
            let h = self.httpHost();
            let colon = Str.lastIndexOf(h, ":");
            if (colon > 0 && Str.indexOf(h, "]") < colon) { return Format.toIntOr(h[colon + 1..], 0); }
            return self.isSecure() ? 443 : 80;
        }
        // "https://example.com" (scheme and host, port included).
        fn root() -> string { return self.scheme() + "://" + self.httpHost(); }
        fn schemeAndHttpHost() -> string { return self.root(); }
        // The URL without its query string.
        fn url() -> string { return self.root() + self.path(); }
        // The URL with its query string.
        fn fullUrl() -> string { return self.root() + self.http.target; }
        // The full URL with `values` added to (or replacing in) its query.
        fn fullUrlWithQuery(values: HashMap<string, any>) -> string {
            let q = new HashMap<string, string>();
            self.http.queryParams().forEach(fn(k: string, v: string) { q.put(k, v); });
            values.forEach(fn(k: string, v: any) { q.put(k, v is string ? v as string : str(v)); });
            return self.url() + Request.queryText(q);
        }
        // The full URL without the query fields `keys`.
        fn fullUrlWithoutQuery(keys: Array<string>) -> string {
            let q = new HashMap<string, string>();
            self.http.queryParams().forEach(fn(k: string, v: string) { if (!keys.contains(k)) { q.put(k, v); } });
            return self.url() + Request.queryText(q);
        }
        private static fn queryText(q: HashMap<string, string>) -> string {
            if (q.size() == 0) { return ""; }
            let keys = q.keys();
            Sort.sort(keys);
            let parts = new Array<string>();
            for (k in keys) { parts.push(Url.encode(k) + "=" + Url.encode(q[k])); }
            return "?" + Str.join(parts, "&");
        }
        fn queryString() -> string { return self.http.queryString(); }
        // A stable id for this request's route and client (sha1 of method, URL and IP).
        fn fingerprint() -> string { return Hash.sha1(self.method() + "|" + self.root() + self.path() + "|" + self.ip()); }

        // ── who is asking, and what for ────────────────────────────────────────
        fn header(name: string, fallback: string = "") -> string { let v = self.http.header(name); return v == "" ? fallback : v; }
        fn hasHeader(name: string) -> bool { return self.http.headers.has(name); }
        fn bearerToken() -> string { return self.http.bearerToken(); }
        // HTTP basic credentials: [user, password], or empty.
        fn basicCredentials() -> Array<string> { return self.http.basicAuth(); }
        // The client's address: the connection's, or (from a trusted proxy) the
        // nearest address in X-Forwarded-For that is not itself a trusted proxy.
        fn ip() -> string {
            let chain = self.ips();
            return chain.size() > 0 ? chain[0] : TrustedProxies.hostOf(self.http.remote);
        }
        // Every client address, the client first (X-Forwarded-For through trusted proxies).
        fn ips() -> Array<string> {
            let out = new Array<string>();
            let direct = TrustedProxies.hostOf(self.http.remote);
            if (!self.isFromTrustedProxy()) { out.push(direct); return out; }
            let hops = new Array<string>();
            for (p in Str.split(self.http.header("X-Forwarded-For"), ",")) { let t = Str.trim(p); if (t != "") { hops.push(TrustedProxies.hostOf(t)); } }
            hops.push(direct);
            // From the nearest hop back, skip trusted proxies: the first other one is the client.
            let i = hops.size() - 1;
            while (i > 0 && TrustedProxies.trusts(Request.trustedProxies, hops[i])) { i -= 1; }
            for (j in 0..(i + 1)) { out.push(hops[i - j]); }
            return out;
        }
        fn userAgent() -> string { return self.http.userAgent(); }
        // Sent by fetch()/XMLHttpRequest libraries.
        fn ajax() -> bool { return Str.lower(self.http.header("X-Requested-With")) == "xmlhttprequest"; }
        // Whether the client prefers JSON over HTML.
        fn wantsJson() -> bool {
            let accept = Str.lower(self.http.header("Accept"));
            return Str.contains(accept, "/json") || Str.contains(accept, "+json");
        }
        // Whether an answer should be JSON: the client wants it, or sent JSON, or is XHR.
        fn expectsJson() -> bool { return self.wantsJson() || self.http.isJson() || (self.ajax() && !Str.contains(Str.lower(self.http.header("Accept")), "text/html")); }
        // The Accept header's media ranges, best first.
        fn acceptableContentTypes() -> Array<string> {
            let out = new Array<string>();
            for (r in AcceptHeader.parse(self.http.header("Accept"))) { out.push(r.mime); }
            return out;
        }
        // Whether the client accepts `mime` ("json" and "html" work as short names).
        fn accepts(mime: string) -> bool { return AcceptHeader.quality(AcceptHeader.parse(self.http.header("Accept")), AcceptHeader.expand(mime)) > 0.0; }
        fn acceptsJson() -> bool { return self.accepts("json"); }
        fn acceptsHtml() -> bool { return self.accepts("html"); }
        fn acceptsAnyContentType() -> bool {
            let a = Str.trim(self.http.header("Accept"));
            return a == "" || Str.contains(a, "*/*") || a == "*";
        }
        // Of `offered` ("json", "html", "text/csv", ...), the one the client likes best ("" for none).
        fn prefers(offered: Array<string>) -> string { return AcceptHeader.prefer(AcceptHeader.parse(self.http.header("Accept")), offered); }
        // "json" or "html": what to answer in when the client does not say.
        fn format(fallback: string = "html") -> string {
            let p = self.prefers(["json", "html"]);
            return p == "" ? fallback : p;
        }
        fn isJson() -> bool { return self.http.isJson(); }
        // A PJAX request (X-PJAX), or a browser prefetching (Purpose/Sec-Purpose: prefetch).
        fn pjax() -> bool { return self.http.header("X-PJAX") != ""; }
        fn prefetch() -> bool {
            return Str.contains(Str.lower(self.http.header("Purpose")), "prefetch") || Str.contains(Str.lower(self.http.header("Sec-Purpose")), "prefetch");
        }
        // The raw body.
        fn content() -> string { return self.http.body(); }
        fn contentType() -> string { return self.http.contentType(); }
        fn hasCookie(name: string) -> bool { return self.cookies().containsKey(name); }
        // The cookies the client sent (parsed once).
        fn cookies() -> HashMap<string, string> {
            if (self.cookieMap == null) { self.cookieMap = self.http.cookies(); }
            return self.cookieMap;
        }
        fn cookie(name: string, fallback: string = "") -> string { return self.cookies().getOr(name, fallback); }

        // ── route values ───────────────────────────────────────────────────────
        fn param(name: string, fallback: string = "") -> string { let v = self.http.param(name); return v == "" ? fallback : v; }
        fn paramInt(name: string, fallback: long = 0) -> long { return Integer.parseOr(self.http.param(name), fallback); }

        // ── input ──────────────────────────────────────────────────────────────
        // The JSON body as plain values (null when it is not JSON, or empty).
        fn json() -> any {
            if (!self.bodyParsed) {
                self.bodyParsed = true;
                if (self.http.isJson() && self.http.bodyBytes.size() > 0) {
                    try { self.bodyValue = Plain.parse(self.http.body()); }
                    catch (e: Exception) { throw new HttpException(400, "the request body is not valid JSON"); }
                }
            }
            return self.bodyValue;
        }
        // Every input value: the query string, then the body (a JSON object's
        // members, or form fields) over it.
        fn all() -> HashMap<string, any> {
            if (self.inputs != null) { return self.inputs; }
            let m = new HashMap<string, any>();
            self.http.queryParams().forEach(fn(k: string, v: string) { m.put(k, v); });
            let body = self.json();
            if (body is HashMap<string, any>) { (body as HashMap<string, any>).forEach(fn(k: string, v: any) { m.put(k, v); }); }
            else if (!self.http.isJson() && self.http.bodyBytes.size() > 0) {
                let ct = self.http.contentType();
                if (ct == "application/x-www-form-urlencoded" || ct == "multipart/form-data" || ct == "") {
                    self.http.form().forEach(fn(k: string, v: string) { m.put(k, v); });
                }
            }
            self.inputs = m;
            return m;
        }
        // An input value by name or dotted path ("user.name", "items.0.id"), or `fallback`.
        // A path with `*` ("items.*.price") gives an Array<any> of every match.
        fn input(key: string, fallback: any = null) -> any {
            let m = self.all();
            if (m.containsKey(key)) { return m[key]; }
            if (Str.indexOf(key, ".") < 0) { return fallback; }
            if (Str.indexOf(key, "*") >= 0) { return Plain.digAll(m, key); }
            let v = Plain.dig(m, key);
            return v == null ? fallback : v;
        }
        // Whether the input has `key` (null values count as present, as a JSON null was sent).
        fn has(key: string) -> bool {
            let m = self.all();
            if (m.containsKey(key)) { return true; }
            if (Str.indexOf(key, ".") < 0) { return false; }
            let dot = Str.lastIndexOf(key, ".");
            let parent = Plain.dig(m, key[..dot]);
            if (parent is HashMap<string, any>) { return (parent as HashMap<string, any>).containsKey(key[dot + 1..]); }
            return Plain.dig(m, key) != null;
        }
        fn exists(key: string) -> bool { return self.has(key); }
        // Whether every one of `keys` is present.
        fn hasAll(keys: Array<string>) -> bool { for (k in keys) { if (!self.has(k)) { return false; } } return true; }
        fn hasAny(keys: Array<string>) -> bool { for (k in keys) { if (self.has(k)) { return true; } } return false; }
        fn anyFilled(keys: Array<string>) -> bool { for (k in keys) { if (self.filled(k)) { return true; } } return false; }
        fn isNotFilled(key: string) -> bool { return !self.filled(key); }
        // Runs `f` with the value when `key` is present; returns the request (calls chain).
        fn whenHas(key: string, f: fn(any)) -> Request { if (self.has(key)) { f(self.input(key)); } return self; }
        // Runs `f` with the value when `key` is filled, else `otherwise` (when given).
        fn whenFilled(key: string, f: fn(any), otherwise: fn() = null) -> Request {
            if (self.filled(key)) { f(self.input(key)); } else if (otherwise != null) { otherwise(); }
            return self;
        }
        fn whenMissing(key: string, f: fn()) -> Request { if (!self.has(key)) { f(); } return self; }
        // The top-level input names.
        fn keys() -> Array<string> { let k = self.all().keys(); Sort.sort(k); return k; }
        // Present and not empty (not "", not whitespace only, not an empty list).
        fn filled(key: string) -> bool {
            let v = self.input(key);
            if (v == null) { return false; }
            if (v is string) { return Str.trim(v as string) != ""; }
            if (v is Array<any>) { return (v as Array<any>).size() > 0; }
            return true;
        }
        fn missing(key: string) -> bool { return !self.has(key); }
        // An input as text (Laravel's name; text() is the same).
        fn string(key: string, fallback: string = "") -> string { return self.text(key, fallback); }
        fn text(key: string, fallback: string = "") -> string {
            let v = self.input(key);
            if (v == null) { return fallback; }
            return v is string ? v as string : str(v);
        }
        fn integer(key: string, fallback: long = 0) -> long {
            let v = self.input(key);
            if (v is long) { return v as long; }
            if (v is double) { return (v as double) as long; }
            if (v is string) { return Integer.parseOr(Str.trim(v as string), fallback); }
            if (v is bool) { return (v as bool) ? 1 : 0; }
            return fallback;
        }
        // An input as a number (number() is the same).
        fn float(key: string, fallback: double = 0.0) -> double { return self.number(key, fallback); }
        fn number(key: string, fallback: double = 0.0) -> double {
            let v = self.input(key);
            if (v is double) { return v as double; }
            if (v is long) { return (v as long) as double; }
            if (v is string) { return Format.toFloatOr(Str.trim(v as string), fallback); }
            return fallback;
        }
        // true for true, 1, "1", "true", "on", "yes"; false otherwise.
        fn boolean(key: string) -> bool {
            let v = self.input(key);
            if (v is bool) { return v as bool; }
            if (v is long) { return (v as long) != 0; }
            if (v is string) {
                let s = Str.lower(Str.trim(v as string));
                return s == "1" || s == "true" || s == "on" || s == "yes";
            }
            return false;
        }
        // A date ("2026-11-14" or "2026-11-14 09:30:00"), or null.
        fn date(key: string, format: string = "") -> DateTime {
            let s = self.text(key);
            if (s == "") { return null; }
            if (format == "") { return DateTime.tryParse(s); }
            try { return DateTime.parse(s, format); } catch (e: Exception) { return null; }
        }
        // A map input (a JSON object), or an empty map.
        fn map(key: string) -> HashMap<string, any> {
            let v = self.input(key);
            return v is HashMap<string, any> ? v as HashMap<string, any> : new HashMap<string, any>();
        }
        // A list input: a JSON array, or the comma-separated values of a text one.
        fn list(key: string) -> Array<any> {
            let v = self.input(key);
            if (v is Array<any>) { return v as Array<any>; }
            let out = new Array<any>();
            if (v is string) {
                for (p in Str.split(v as string, ",")) { let t = Str.trim(p); if (t != "") { out.push(t); } }
            } else if (v != null) { out.push(v); }
            return out;
        }
        // The named inputs that are present; a dotted name keeps its nesting
        // ("user.name" gives {"user": {"name": ...}}).
        fn only(keys: Array<string>) -> HashMap<string, any> {
            let out = new HashMap<string, any>();
            for (k in keys) {
                if (!self.has(k)) { continue; }
                if (Str.indexOf(k, ".") >= 0 && Str.indexOf(k, "*") < 0) { Plain.setPath(out, k, self.input(k)); }
                else { out.put(k, self.input(k)); }
            }
            return out;
        }
        fn except(keys: Array<string>) -> HashMap<string, any> {
            let skip = new HashSet<string>();
            for (k in keys) { skip.add(k); }
            let out = new HashMap<string, any>();
            self.all().forEach(fn(k: string, v: any) { if (!skip.contains(k)) { out.put(k, v); } });
            return out;
        }
        // Adds (or replaces) input values, as if the client had sent them.
        fn merge(values: HashMap<string, any>) { let m = self.all(); values.forEach(fn(k: string, v: any) { m.put(k, v); }); }
        // Adds only the values whose names the input does not have yet.
        fn mergeIfMissing(values: HashMap<string, any>) {
            let m = self.all();
            values.forEach(fn(k: string, v: any) { if (!m.containsKey(k)) { m.put(k, v); } });
        }
        // Replaces the whole input with `values`.
        fn replace(values: HashMap<string, any>) {
            let m = new HashMap<string, any>();
            values.forEach(fn(k: string, v: any) { m.put(k, v); });
            self.inputs = m;
        }
        // A body value only (not the query string).
        fn post(key: string, fallback: any = null) -> any {
            let body = self.json();
            if (body is HashMap<string, any>) { let v = Plain.dig(body, key); return v == null ? fallback : v; }
            let v = self.http.formValue(key);
            return v == "" ? fallback : v as any;
        }
        // Every query-string field.
        fn queryAll() -> HashMap<string, string> { return self.http.queryParams(); }
        fn hasQuery(key: string) -> bool { return self.http.hasQuery(key); }
        fn query(key: string, fallback: string = "") -> string { let v = self.http.query(key); return v == "" ? fallback : v; }

        // ── files ──────────────────────────────────────────────────────────────
        fn file(name: string) -> UploadedFile {    // ("" just parses them)
            if (self.files == null) {
                self.files = new HashMap<string, UploadedFile>();
                for (p in self.http.files()) { if (!self.files.containsKey(p.name)) { self.files.put(p.name, new UploadedFile(p)); } }
            }
            return self.files.getOr(name, null);
        }
        fn hasFile(name: string) -> bool { return self.file(name) != null; }
        // Every uploaded file (the first per field name).
        fn allFiles() -> Array<UploadedFile> {
            self.file("");
            let out = new Array<UploadedFile>();
            let names = self.files.keys();
            Sort.sort(names);
            for (n in names) { out.push(self.files[n]); }
            return out;
        }

        // ── the previous request's input (needs a session) ─────────────────────
        // What the previous request sent for `key` (flashed when it failed
        // validation), to refill a form; `fallback` without a session.
        fn old(key: string, fallback: any = null) -> any {
            if (!(self.session is OldInputStore)) { return fallback; }
            let v = (self.session as OldInputStore).oldInput(key);
            return v == null ? fallback : v;
        }
        // Keeps this request's input for the next request's old().
        fn flash() { self.flashValues(self.all()); }
        fn flashOnly(keys: Array<string>) { self.flashValues(self.only(keys)); }
        fn flashExcept(keys: Array<string>) { self.flashValues(self.except(keys)); }
        private fn flashValues(values: HashMap<string, any>) {
            if (self.session is OldInputStore) { (self.session as OldInputStore).flashInput(values); }
        }

        // ── validation (with apogee-validation) ────────────────────────────────
        // Validates the input against `rules` ("email": "required|email|max:255"
        // or a list of rules); the validated data, or a ValidationException
        // (a 422 for JSON clients; a redirect back with errors and old input otherwise).
        fn validate(rules: HashMap<string, any>, messages: HashMap<string, string> = new HashMap<string, string>(),
                    attributes: HashMap<string, string> = new HashMap<string, string>()) -> HashMap<string, any> {
            if (Request.validator == null) { throw new StateError("validate() needs apogee-validation: import it"); }
            let run = Request.validator;
            let data = run(self, self.all(), rules, messages, attributes);
            self.set("apogee.validated", data);
            return data;
        }
        // What the last validate() passed (an empty map before one).
        fn validated() -> HashMap<string, any> {
            let v = self.get("apogee.validated");
            return v is HashMap<string, any> ? v as HashMap<string, any> : new HashMap<string, any>();
        }

        // ── the route ──────────────────────────────────────────────────────────
        // A route value: the model the router bound for it, else its text.
        fn route(name: string) -> any {
            let bound = self.get(name);
            return bound != null ? bound : self.http.param(name) as any;
        }
        // The signed-in user as a T (null for a guest).
        fn userAs<T>() -> T { return self.user == null ? null : self.user as T; }

        // ── attributes (what middleware leaves for later) ──────────────────────
        fn set(key: string, value: any) { if (self.attrs == null) { self.attrs = new HashMap<string, any>(); } self.attrs.put(key, value); }
        fn get(key: string, fallback: any = null) -> any { return self.attrs == null ? fallback : self.attrs.getOr(key, fallback); }
        fn hasAttribute(key: string) -> bool { return self.attrs != null && self.attrs.containsKey(key); }
        // This request's scope of the application's container (made on first
        // use, with the Request itself in it); null without a container.
        fn scope() -> Container {
            if (self.scoped == null && self.app != null) {
                self.scoped = self.app.scope();
                self.scoped.provide::<Request>(self);
            }
            return self.scoped;
        }
        // Ends the scope (the kernel does, once the response is made): frees its
        // scoped values, and the request they refer to, right away.
        fn endScope() { if (self.scoped != null) { self.scoped.dispose(); self.scoped = null; } }
        // A service from the request's scope.
        fn make<T>() -> T {
            let s = self.scope();
            if (s == null) { throw new StateError("this request has no container"); }
            return s.make::<T>();
        }

        // "admin/*" against "admin/users": `*` matches any run of characters.
        static fn glob(pattern: string, text: string) -> bool {
            if (pattern == "*" || pattern == text) { return true; }
            let star = Str.indexOf(pattern, "*");
            if (star < 0) { return false; }
            if (!Str.startsWith(text, pattern[..star])) { return false; }
            let rest = pattern[star + 1..];
            if (rest == "") { return true; }
            for (i in star..(text.length + 1)) { if (Request.glob(rest, text[i..])) { return true; } }
            return false;
        }
    }
}
